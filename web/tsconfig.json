{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2025", "DOM", "DOM.Iterable"],
		"types": ["svelte", "vite/client"],
		"strict": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true
	},
	"include": ["src", "vite.config.ts"]
}
