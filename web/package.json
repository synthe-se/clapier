{
	"name": "clapier-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"i18n": "paraglide-js compile --project ../i18n/project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations",
		"test": "vitest run",
		"check": "bun run i18n && bun scripts/i18n.check.ts && bun scripts/css.check.ts && svelte-check --tsconfig ./tsconfig.json"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@fontsource-variable/fraunces": "5.3.0",
		"@inlang/paraglide-js": "3.2.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"bits-ui": "2.22.0",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}
