// G6: config sector parsers, the watchdog's decision table, ARP aging,
// the radio-duplicate filter, and the reassoc guards.

fun _t_pad s n = strcat s (_t_rep "\0" (n - (strlen s)));;

// A fabricated 226-byte sector: server URL, SSID Freebox-TEST, given
// crypt byte, PMK of 32 x 0xAB, magic 0x42.
fun _t_conf_sector server crypt =
    strcatlist
        (_t_pad server 58) ::            // url(41) + dhcp + ip/mask/gw/dns
        (_t_pad "Freebox-TEST" 32) ::    // ssid @58
        "\0" ::                          // auth @90
        crypt ::                         // crypt @91
        (_t_rep "\0" 83) ::              // key0(64) + free, up to 175
        (_t_rep "\$AB" 32) ::            // pmk @175
        "\$42" ::                        // magic @207
        (_t_rep "\0" 18) :: nil;;        // tail to 226

fun _t_conf =
    let _t_conf_sector "192.168.1.165/vl" "\$40" -> s in
    (
        t_int "conf sector length" (strlen s) CONF_LENGTH;
        t_eq "conf ssid" (conf_ssid s) "Freebox-TEST";
        t_int "conf auth" (conf_auth s) 0;
        t_int "conf crypt" (conf_crypt s) CRYPT_WPA2;
        t_eq "conf pmk" (conf_pmk s) (_t_rep "\$AB" 32);
        t_int "conf magic" (conf_magic s) 0x42;
        t_eq "conf server" (conf_server s) "192.168.1.165/vl";
        t_eq "conf server ip" (conf_server_ip s) "\$C0\$A8\$01\$A5"
    );
    t_true "server hostname is nil" ((conf_server_ip (_t_conf_sector "r.nabaztag.com/vl" "\$40")) == nil);
    t_true "server bad quad is nil" ((conf_server_ip (_t_conf_sector "300.1.2.3/vl" "\$40")) == nil);
    t_eq "server bare quad" (conf_server_ip (_t_conf_sector "10.0.0.1" "\$40")) "\$0A\$00\$00\$01";
    // The shape the real EEPROM turned out to hold (session 5).
    t_eq "server with port" (conf_server_ip (_t_conf_sector "192.168.1.165:80/vl/" "\$40")) "\$C0\$A8\$01\$A5";
    0;;

fun _t_server =
    let CLAPIER_IP -> keep in
    (
        t_int "no sector keeps the default" (link_apply_server nil) 0;
        t_int "hostname keeps the default" (link_apply_server (_t_conf_sector "r.nabaztag.com/vl" "\$40")) 0;
        t_eq "clapier ip untouched" CLAPIER_IP keep;
        t_int "dotted quad adopted" (link_apply_server (_t_conf_sector "10.0.0.7:80/vl/" "\$40")) 1;
        t_eq "clapier ip is the sector's" CLAPIER_IP "\$0A\$00\$00\$07";
        set CLAPIER_IP = keep
    );
    0;;

fun _t_url =
    t_eq "url ip" (url_ip "192.168.1.10/vl") "\$C0\$A8\$01\$0A";
    t_int "url default port" (url_port "192.168.1.10/vl") 80;
    t_int "url named port" (url_port "192.168.1.10:8080/vl/") 8080;
    t_true "url bad port" ((url_port "192.168.1.10:http/vl") == nil);
    t_true "url empty port" ((url_port "192.168.1.10:/vl") == nil);
    t_true "url port zero" ((url_port "192.168.1.10:0/vl") == nil);
    t_eq "url path" (url_path "192.168.1.10/vl") "/vl";
    t_eq "url path keeps its slash" (url_path "192.168.1.103:80/vl/") "/vl/";
    t_eq "url no path" (url_path "10.0.0.1") "";
    let conf_server_field "192.168.1.10/vl" -> f in
    (
        t_int "server field length" (strlen f) CONF_SERVER_LEN;
        t_eq "server field reads back" (conf_server f) "192.168.1.10/vl";
        t_int "server field is NUL padded" (strget f 40) 0
    );
    t_true "server field refuses a hostname" ((conf_server_field "r.nabaztag.com/vl") == nil);
    t_true "server field refuses a bad port" ((conf_server_field "10.0.0.1:x/vl") == nil);
    t_true "server field refuses 41 chars"
        ((conf_server_field "192.168.100.100:8080/a/very/long/path/vl/") == nil);
    t_int "server field takes 40 chars"
        (strlen (conf_server_field "192.168.100.100:8080/a/very/long/path/vl")) CONF_SERVER_LEN;
    0;;

fun _t_firmware =
    t_eq "env signed by the boot"
        (env_firmware_of (strcat (_t_rep "\0" 20) "NABGaae9e4cc")) "aae9e4cc";
    t_eq "env of an older boot" (env_firmware_of (_t_rep "\0" 64)) "?";
    t_eq "env too short to be signed" (env_firmware_of "NABGaae9e4cc") "?";
    0;;

fun _t_fw =
    // Adler-32("Wikipedia") = 0x11E60398.
    let fw_adler "Wikipedia" -> [a b] in
    (
        t_int "adler low half" a 0x0398;
        t_int "adler high half" b 0x11E6
    );
    let fw_adler (_t_rep "\$FF" 6000) -> [a b] in
    (
        // Long enough for both halves to wrap many times.
        t_int "adler low wraps" a 23018;
        t_int "adler high wraps" b 42135
    );
    let strcat (_t_rep "\$18\$F0\$9F\$E5" 5) (_t_rep "\0" 12) -> v in
    (
        t_true "vectors of a firmware" (fw_vectors_ok v);
        t_true "vectors too short" (!(fw_vectors_ok (strsub v 0 20)));
        t_true "vectors of noise" (!(fw_vectors_ok (_t_rep "x" 64)))
    );
    let fw_args "/vl/fw/nab.bin 106744 11e60398" -> [path len a b] in
    (
        t_eq "fw path" path "/vl/fw/nab.bin";
        t_int "fw len" len 106744;
        t_int "fw sum low" a 0x0398;
        t_int "fw sum high" b 0x11E6
    );
    t_true "fw refuses a foreign path" ((fw_args "/etc/nab.bin 106744 11e60398") == nil);
    t_true "fw refuses past the config sector" ((fw_args "/vl/fw/nab.bin 126977 11e60398") == nil);
    t_true "fw refuses a tiny image" ((fw_args "/vl/fw/nab.bin 100 11e60398") == nil);
    t_true "fw refuses a short sum" ((fw_args "/vl/fw/nab.bin 106744 398") == nil);
    t_true "fw refuses missing args" ((fw_args "/vl/fw/nab.bin") == nil);
    0;;

// A room, block by block: returns how many double claps were heard.
fun _t_room l n =
    if l == nil then n
    else _t_room (tl l) (n + (clap_step (hd l)));;

fun _t_quiet n = if n <= 0 then nil else 5 :: (_t_quiet (n - 1));;
fun _t_append a b = if a == nil then b else (hd a) :: (_t_append (tl a) b);;
fun _t_cat4 a b c d = _t_append a (_t_append b (_t_append c d));;

fun _t_claps =
    // quiet, clap, 300 ms, clap, quiet
    clap_reset;
    t_int "two claps are one double clap"
        (_t_room (_t_cat4 (_t_quiet 10) (900 :: 200 :: nil)
                  (_t_append (_t_quiet 4) (800 :: nil)) (_t_quiet 6)) 0) 1;
    clap_reset;
    t_int "one clap is nothing"
        (_t_room (_t_cat4 (_t_quiet 10) (900 :: nil) (_t_quiet 20) nil) 0) 0;
    clap_reset;
    t_int "two claps too far apart are nothing"
        (_t_room (_t_cat4 (_t_quiet 10) (900 :: nil)
                  (_t_append (_t_quiet 16) (900 :: nil)) (_t_quiet 6)) 0) 0;
    clap_reset;
    t_int "a long noise is not a clap"
        (_t_room (_t_cat4 (_t_quiet 10) (900 :: 900 :: 900 :: 900 :: 900 :: nil)
                  (_t_append (_t_quiet 4) (900 :: nil)) (_t_quiet 6)) 0) 0;
    clap_reset;
    t_int "three claps are one event, then deaf for a moment"
        (_t_room (_t_cat4 (_t_quiet 10) (900 :: nil)
                  (_t_append (_t_quiet 4) (900 :: nil))
                  (_t_append (_t_quiet 4) (_t_append (900 :: nil) (_t_quiet 6)))) 0) 1;
    clap_reset;
    t_int "a quiet room stays quiet" (_t_room (_t_quiet 60) 0) 0;
    clap_reset;
    // a room at 30 is quiet too: its floor rises, 80 is no longer loud
    t_int "a clap must rise above the room"
        (_t_room (_t_cat4 (30 :: 30 :: 30 :: 30 :: 30 :: 30 :: 30 :: 30 :: 30 :: 30 :: 30 :: 30 :: nil)
                  (80 :: 30 :: 30 :: 30 :: nil) (80 :: 30 :: 30 :: nil) nil) 0) 0;
    0;;

fun _t_decide =
    t_int "up and chatty" (link_decide 4 1000 nil 0) LINK_ACT_NONE;
    t_int "quiet lan probes" (link_decide 4 40000 nil 0) LINK_ACT_PROBE;
    t_int "rx dead reassoc" (link_decide 4 100000 nil 0) LINK_ACT_REASSOC;
    t_int "idle reassoc now" (link_decide 1 1000 nil 0) LINK_ACT_REASSOC;
    t_int "settling waits" (link_decide 1 1000 5000 1) LINK_ACT_NONE;
    t_int "grace over retry" (link_decide 1 1000 25000 1) LINK_ACT_REASSOC;
    t_int "enough fails reboot" (link_decide 1 1000 25000 2) LINK_ACT_REBOOT;
    t_int "driver busy none" (link_decide 3 40000 nil 0) LINK_ACT_NONE;
    t_int "driver stuck reboot" (link_decide 2 200000 nil 0) LINK_ACT_REBOOT;
    t_int "broken radio reassoc" (link_decide 0 1000 nil 0) LINK_ACT_REASSOC;
    0;;

fun _t_take =
    let 1 :: 2 :: 3 :: nil -> l in
    (
        t_int "take keeps head" (hd (list_take l 2)) 1;
        t_true "take stops at n" ((tl (tl (list_take l 2))) == nil);
        t_true "take zero is empty" ((list_take l 0) == nil)
    );;

fun _t_arp_age =
    let "\$C0\$A8\$01\$01" -> ip in
    let "\$AA\$AA\$AA\$AA\$AA\$01" -> m1 in
    let [ip m1 1000] :: nil -> cache in
    (
        t_eq "arp fresh hit" (_arp_find cache ip 2000) m1;
        t_true "arp aged out" ((_arp_find cache ip 700000) == nil);
        t_true "arp miss other ip" ((_arp_find cache "\$C0\$A8\$01\$02" 2000) == nil)
    );
    // Re-learned ip replaces its entry, never stacks a stale twin.
    set _arp_cache = nil;
    _arp_cache_put "\$0A\$00\$00\$05" "\$AA\$AA\$AA\$AA\$AA\$02";
    _arp_cache_put "\$0A\$00\$00\$05" "\$AA\$AA\$AA\$AA\$AA\$03";
    t_eq "arp refresh newest" (arp_lookup "\$0A\$00\$00\$05") "\$AA\$AA\$AA\$AA\$AA\$03";
    t_true "arp refresh single entry" ((tl _arp_cache) == nil);
    set _arp_cache = nil;
    0;;

fun _t_dedup =
    set _rx_seen = nil;
    set _rx_dedup_on = 1;
    t_int "first sighting passes" (rx_dedup "\$C0\$A8\$01\$50" 0x1234) 0;
    t_int "duplicate dropped" (rx_dedup "\$C0\$A8\$01\$50" 0x1234) 1;
    t_int "other ident passes" (rx_dedup "\$C0\$A8\$01\$50" 0x1235) 0;
    t_int "other src passes" (rx_dedup "\$C0\$A8\$01\$51" 0x1234) 0;
    t_true "stale sighting forgotten"
        (!(_dedup_find (["\$C0\$A8\$01\$50" 0x1234 0] :: nil) "\$C0\$A8\$01\$50" 0x1234 5000));
    // Through the dispatcher: the same ICMP frame twice, one reply.
    // Valid frames feed the liveness counter; garbage must not.
    set _rx_seen = nil;
    set stat_rx_dups = 0;
    set stat_rx_valid = 0;
    wire_rx T_ICMP_REQ T_PEER_MAC;
    wire_rx T_ICMP_REQ T_PEER_MAC;
    t_int "radio duplicate filtered" stat_rx_dups 1;
    t_int "valid frames counted" stat_rx_valid 2;
    wire_rx T_IP_BAD T_PEER_MAC;
    t_int "garbage not counted alive" stat_rx_valid 2;
    wire_rx T_ARP_REQ T_PEER_MAC;
    t_int "arp counts alive" stat_rx_valid 3;
    0;;

fun _t_reassoc =
    set stat_reassoc = 0;
    set _link_conf = nil;
    t_int "reassoc without config refuses" link_reassoc 0;
    set _link_conf = _t_conf_sector "x" "\$10";
    t_int "reassoc wep refused" link_reassoc 0;
    set _link_conf = _t_conf_sector "192.168.1.165/vl" "\$40";
    t_int "reassoc empty scan gives up" link_reassoc 0;
    t_int "reassoc attempts counted" stat_reassoc 3;
    t_int "reassoc fails counted" _link_reassoc_fails 3;
    0;;

fun t_link =
    _t_conf;
    _t_server;
    _t_url;
    _t_firmware;
    _t_fw;
    _t_claps;
    _t_decide;
    _t_take;
    _t_arp_age;
    _t_dedup;
    _t_reassoc;
    0;;
