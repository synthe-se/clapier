// Who we are. Included early so every module can state it.

const GARENNE_VERSION = "0.15.0";;

var garenne_boot_s = 0;;

// Counted on the VM's seconds clock. time_ms is a 31-bit value: after
// 12.4 days a difference of milliseconds this long turns negative (a
// rabbit two weeks old answered up=-862007s), while every short
// interval elsewhere stays right through the wrap.
fun garenne_uptime_s = time - garenne_boot_s;;
